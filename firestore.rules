rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Access control list itself. Anyone signed in can read their OWN doc
    // (so the login page can check "am I an admin?"); only admins can see
    // the full list or write.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // E-Board: public can read, only admins can write
    match /eboard/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events: public can read, only admins can write
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Members: private — admins only
    match /members/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
