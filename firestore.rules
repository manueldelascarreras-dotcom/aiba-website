rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // E-Board: public can read, only signed-in admins can write
    match /eboard/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Events: public can read, only signed-in admins can write
    match /events/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Members: private — only signed-in admins can read or write
    match /members/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
